{
  "datasets": [
    {
      "name": "kpi_summary",
      "displayName": "KPI Summary",
      "queryLines": [
        "SELECT ",
        "  ROUND(SUM(CAST(total_amount AS DOUBLE)), 2) AS total_revenue, ",
        "  COUNT(DISTINCT order_id) AS total_orders, ",
        "  COUNT(DISTINCT customer_id) AS active_customers, ",
        "  ROUND(AVG(CAST(total_amount AS DOUBLE)), 2) AS avg_order_value, ",
        "  ROUND(SUM(CASE WHEN status = 'Cancelled' THEN 1.0 ELSE 0.0 END) * 100.0 / COUNT(*), 1) AS cancellation_rate_pct, ",
        "  ROUND(SUM(CASE WHEN status = 'Delivered' THEN CAST(total_amount AS DOUBLE) ELSE 0 END), 2) AS realized_revenue, ",
        "  ROUND(SUM(CASE WHEN status IN ('Cancelled','Returned') THEN CAST(total_amount AS DOUBLE) ELSE 0 END), 2) AS at_risk_revenue ",
        "FROM orders_current "
      ]
    },
    {
      "name": "daily_trend",
      "displayName": "Daily Revenue Trend",
      "queryLines": [
        "SELECT ",
        "  order_date, ",
        "  CAST(total_revenue AS DOUBLE) AS total_revenue, ",
        "  CAST(realized_revenue AS DOUBLE) AS realized_revenue, ",
        "  CAST(pipeline_revenue AS DOUBLE) AS pipeline_revenue, ",
        "  CAST(at_risk_revenue AS DOUBLE) AS at_risk_revenue, ",
        "  total_orders ",
        "FROM daily_sales_summary ",
        "ORDER BY order_date "
      ]
    },
    {
      "name": "monthly_breakdown",
      "displayName": "Monthly Breakdown",
      "queryLines": [
        "SELECT ",
        "  DATE_TRUNC('MONTH', order_date) AS month, ",
        "  ROUND(SUM(CAST(total_revenue AS DOUBLE)), 2) AS monthly_revenue, ",
        "  SUM(total_orders) AS monthly_orders, ",
        "  ROUND(SUM(CAST(realized_revenue AS DOUBLE)), 2) AS monthly_realized, ",
        "  ROUND(SUM(CAST(at_risk_revenue AS DOUBLE)), 2) AS monthly_at_risk, ",
        "  ROUND(SUM(CAST(pipeline_revenue AS DOUBLE)), 2) AS monthly_pipeline ",
        "FROM daily_sales_summary ",
        "GROUP BY DATE_TRUNC('MONTH', order_date) ",
        "ORDER BY month "
      ]
    },
    {
      "name": "by_status",
      "displayName": "Revenue by Status",
      "queryLines": [
        "SELECT ",
        "  status, ",
        "  COUNT(*) AS order_count, ",
        "  ROUND(SUM(CAST(total_amount AS DOUBLE)), 2) AS revenue ",
        "FROM orders_current ",
        "GROUP BY status ",
        "ORDER BY revenue DESC "
      ]
    },
    {
      "name": "membership_data",
      "displayName": "Membership Metrics",
      "queryLines": [
        "SELECT ",
        "  membership_level, ",
        "  total_customers, ",
        "  total_orders, ",
        "  orders_per_customer, ",
        "  CAST(total_revenue AS DOUBLE) AS total_revenue, ",
        "  CAST(avg_ltv_per_customer AS DOUBLE) AS avg_ltv_per_customer, ",
        "  CAST(cancellation_rate_pct AS DOUBLE) AS cancellation_rate_pct, ",
        "  avg_items_per_order ",
        "FROM membership_metrics ",
        "ORDER BY membership_tier_rank "
      ]
    },
    {
      "name": "top_products",
      "displayName": "Top Products",
      "queryLines": [
        "SELECT ",
        "  product_name, ",
        "  SUM(quantity) AS total_quantity, ",
        "  ROUND(SUM(CAST(line_total AS DOUBLE)), 2) AS total_revenue, ",
        "  COUNT(DISTINCT order_id) AS order_count ",
        "FROM line_items_current ",
        "GROUP BY product_name ",
        "ORDER BY total_revenue DESC ",
        "LIMIT 10 "
      ]
    },
    {
      "name": "by_region",
      "displayName": "Customers by Region",
      "queryLines": [
        "SELECT ",
        "  region, ",
        "  COUNT(*) AS customer_count ",
        "FROM dim_customers ",
        "WHERE __END_AT IS NULL ",
        "GROUP BY region ",
        "ORDER BY customer_count DESC "
      ]
    },
    {
      "name": "order_tiers",
      "displayName": "Order Value Tiers",
      "queryLines": [
        "SELECT ",
        "  order_value_tier, ",
        "  COUNT(*) AS order_count, ",
        "  ROUND(SUM(CAST(total_amount AS DOUBLE)), 2) AS revenue ",
        "FROM orders_current ",
        "GROUP BY order_value_tier ",
        "ORDER BY order_count DESC "
      ]
    },
    {
      "name": "revenue_forecast",
      "displayName": "Revenue Forecast",
      "queryLines": [
        "WITH monthly AS ( ",
        "  SELECT ",
        "    DATE_TRUNC('MONTH', order_date) AS month, ",
        "    ROUND(SUM(CAST(total_revenue AS DOUBLE)), 2) AS revenue ",
        "  FROM daily_sales_summary ",
        "  WHERE order_date < DATE_TRUNC('MONTH', current_date()) ",
        "  GROUP BY DATE_TRUNC('MONTH', order_date) ",
        "), ",
        "monthly_with_lag AS ( ",
        "  SELECT month, revenue, LAG(revenue) OVER (ORDER BY month) AS prev_revenue ",
        "  FROM monthly ",
        "), ",
        "recent_growth AS ( ",
        "  SELECT ",
        "    AVG((revenue - prev_revenue) / NULLIF(prev_revenue, 0)) AS avg_growth_rate, ",
        "    MAX(month) AS last_month, ",
        "    AVG(revenue) AS avg_revenue ",
        "  FROM monthly_with_lag ",
        "  WHERE prev_revenue IS NOT NULL ",
        "    AND month >= add_months((SELECT MAX(month) FROM monthly), -4) ",
        ") ",
        "SELECT month, revenue, 'Actual' AS series_type FROM monthly ",
        "UNION ALL ",
        "SELECT add_months(last_month, 1), ROUND(avg_revenue * (1 + avg_growth_rate), 2), 'Forecast' FROM recent_growth ",
        "UNION ALL ",
        "SELECT add_months(last_month, 2), ROUND(avg_revenue * POWER(1 + avg_growth_rate, 2), 2), 'Forecast' FROM recent_growth ",
        "UNION ALL ",
        "SELECT add_months(last_month, 3), ROUND(avg_revenue * POWER(1 + avg_growth_rate, 3), 2), 'Forecast' FROM recent_growth ",
        "ORDER BY month "
      ]
    }
  ],
